# NoteAgent 配置模板（DESIGN.md：配置即代码，与本文件对应 src/infra/config.py）
# 用法：复制为 .env 并填入真实值。.env 已被 gitignore，绝不能提交。

# ── LLM（OpenAI 兼容 API）──
# DeepSeek（默认）
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
# 切换通义千问示例：
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=qwen-plus

# 向量嵌入模型（Chroma 集合会记录此指纹，切换后需重建向量库）
EMBEDDING_MODEL_NAME=text-embedding-ada-002

# LLM 调用模式：record=真实调用并落台账（默认）；replay=按指纹离线回放（调试/CI 零成本）
LLM_MODE=record
# 并发信号量、超时（秒）、网络错误重试次数、结构化输出修复重试次数
LLM_CONCURRENCY=4
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=5
LLM_SCHEMA_FIX_RETRIES=2
# 单次整理运行的成本上限（元），超限暂停任务
LLM_RUN_COST_CAP_CNY=20

# 费率表（元/百万 token，[输入, 输出]，JSON 格式），用于成本预估与护栏
# PRICE_TABLE={"deepseek-chat": [2.0, 8.0]}

# ── 路径 ──
# Obsidian 仓库路径（开发调试指向样例仓库）
VAULT_DIR=./notebooks
DATA_DIR=./data
LOGS_DIR=./logs
# vault 内生成物专用目录名
ARTIFACTS_DIRNAME=_noteagent

# ── 采集排除与忽略 ──
# 排除的目录名（JSON 数组）
# EXCLUDE_DIRS=[".obsidian", ".git", ".venv", "__pycache__", "node_modules", "_noteagent"]
# 忽略的 glob 模式（JSON 数组），命中的笔记不参与提炼建树，如：
# IGNORE_PATHS=["私有/**", "**/日记-*.md"]

# ── 备份与产物版本 ──
BACKUP_KEEP=5
ARTIFACT_VERSIONS_KEEP=5

# ── 本地 Web 服务 ──
HOST=127.0.0.1
PORT=8686

# ── 树重建 Agent 护栏 ──
AGENT_MAX_STEPS=12
CONFIDENCE_REVIEW_THRESHOLD=0.6
